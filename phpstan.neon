includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        # No aggregate uses the lock version yet; tests/Feature/Platform/CommandContractTest.php covers it until one does.
        -
            identifier: trait.unused
            path: app/Modules/Platform/Support/HasLockVersion.php
